load("@contrib_rules_jvm//java:defs.bzl", "java_test_suite")
load("@rules_java//java:defs.bzl", "java_library")

# gazelle:java_module_granularity module

java_library(
    name = "module1-client",
    srcs = ["src/main/java/com/client/Client.java"],
    resources = ["//module1-client/src/main/resources"],
    visibility = ["//:__subpackages__"],
)

java_test_suite(
    name = "module1-client-tests",
    srcs = ["src/test/java/com/client/ClientTest.java"],
    deps = [":module1-client"],
)
