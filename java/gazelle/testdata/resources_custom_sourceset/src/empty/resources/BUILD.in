# gazelle:java_generate_resources true

load("@rules_java//java:defs.bzl", "java_library")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

pkg_files(
    name = "resources",
    srcs = ["removed.txt"],
    strip_prefix = "",
)

java_library(
    name = "resources_lib",
    resources = [":resources"],
    visibility = ["//:__subpackages__"],
)
